---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Tile {
  title: string;
  text: string;
  image: ImageMetadata;
  alt: string;
  /** clases de grilla (span/aspect) para romper la cuadrícula */
  cls: string;
  pos?: string;
}
interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  lead: string;
  tiles: Tile[];
}
const { id, eyebrow, title, lead, tiles } = Astro.props;
---

<section id={id} class="mx-auto max-w-7xl scroll-mt-20 px-4 py-16 sm:px-6 sm:py-24">
  <div class="reveal max-w-3xl">
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="display-lg mt-2 text-forest">{title}</h2>
    <p class="mt-4 text-lg text-muted-foreground">{lead}</p>
  </div>

  <div class="mt-10 grid grid-cols-2 gap-3 sm:gap-5 md:grid-cols-6">
    {
      tiles.map((tile, i) => (
        <figure
          class:list={["reveal zoom-hover group relative overflow-hidden", i % 2 ? "photo-organic-alt" : "photo-organic", tile.cls]}
          style={`--d:${i * 70}ms`}
        >
          <Image
            src={tile.image}
            alt={tile.alt}
            widths={[400, 700, 1000]}
            sizes="(min-width: 768px) 50vw, 100vw"
            loading="lazy"
            class="h-full w-full object-cover"
            style={tile.pos ? `object-position:${tile.pos}` : undefined}
          />
          <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-forest/90 to-transparent p-4 pt-14 text-white">
            <h3 class="text-xl font-extrabold uppercase sm:text-2xl">{tile.title}</h3>
            <p class="text-sm font-semibold text-white/90">{tile.text}</p>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>
