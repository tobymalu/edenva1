---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Panel {
  word: string;
  image: ImageMetadata;
  alt: string;
  pos?: string;
}
interface Props {
  panels: Panel[];
}
const { panels } = Astro.props;
---

<section class="bg-forest" aria-label={panels.map((p) => p.word).join(" → ")}>
  <div class="snap-carousel flex gap-1 overflow-x-auto lg:overflow-visible">
    {
      panels.map((p, i) => (
        <figure class="zoom-hover relative h-[62svh] min-h-[420px] w-[78vw] shrink-0 overflow-hidden lg:w-auto lg:flex-1 lg:transition-[flex] lg:duration-700 lg:hover:flex-[1.6]">
          <Image
            src={p.image}
            alt={p.alt}
            widths={[500, 800, 1100]}
            sizes="(min-width: 1024px) 25vw, 78vw"
            loading="lazy"
            class="h-full w-full object-cover"
            style={p.pos ? `object-position:${p.pos}` : undefined}
          />
          <div class="absolute inset-0 bg-gradient-to-t from-forest/85 via-transparent to-forest/10" />
          <figcaption class="absolute inset-x-0 bottom-0 p-5 text-white">
            <span class="font-display text-sm font-bold tracking-widest text-accent-glow">0{i + 1}</span>
            <span class="block font-display text-[clamp(1.5rem,7vw,2.2rem)] lg:text-[clamp(1.1rem,1.65vw,1.7rem)] font-extrabold uppercase leading-none [overflow-wrap:anywhere]">{p.word}</span>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>
