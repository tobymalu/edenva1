---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BookingCTA from "@/components/BookingCTA.astro";

interface Props {
  image: ImageMetadata;
  alt: string;
  title: string;
  text: string;
  label: string;
}
const { image, alt, title, text, label } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-forest px-4 py-24 text-center text-white sm:px-6 sm:py-32">
  <Image src={image} alt={alt} widths={[600, 1000, 1600]} sizes="100vw" loading="lazy" class="absolute inset-0 -z-10 h-full w-full object-cover" />
  <div class="absolute inset-0 -z-10 bg-forest/65"></div>
  <div class="reveal mx-auto max-w-3xl">
    <h2 class="display-xl [text-wrap:balance]">{title}</h2>
    <p class="mx-auto mt-5 max-w-xl text-lg font-semibold">{text}</p>
    <BookingCTA label={label} class="mt-8" />
  </div>
</section>
