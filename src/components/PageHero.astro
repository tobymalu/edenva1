---
// Cabecera compartida de las páginas internas: foto + titular grande, esquinas inferiores orgánicas.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  alt?: string;
  eyebrow?: string;
  title: string;
  lead?: string;
  imagePos?: string;
}
const { image, alt = "", eyebrow, title, lead, imagePos } = Astro.props;
---

<header class="relative isolate flex min-h-[46svh] items-end overflow-hidden rounded-b-[2.5rem] bg-forest text-white sm:min-h-[52svh] sm:rounded-b-[4rem]">
  <Image
    src={image}
    alt={alt}
    widths={[480, 800, 1200, 1600]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-10 h-full w-full object-cover"
    style={imagePos ? `object-position:${imagePos}` : undefined}
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-forest/95 via-forest/55 to-forest/10"></div>

  <div class="mx-auto w-full max-w-7xl px-4 pb-10 pt-20 sm:px-6 sm:pb-14">
    {eyebrow && <p class="eyebrow" style="color:var(--color-accent-glow)">{eyebrow}</p>}
    <h1 class="display-lg mt-2 max-w-4xl [text-wrap:balance]">{title}</h1>
    {lead && <p class="mt-4 max-w-2xl text-lg font-semibold text-white/95">{lead}</p>}
    <slot />
  </div>
</header>
