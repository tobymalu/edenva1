---
import { useTranslations, useRoutes, type Lang } from "@/i18n/utils";
import { TOUR_SLUGS } from "@/data/slugMaps";

interface Props {
  lang: Lang;
  /** slug de carpeta del tour (la clave en TOUR_SLUGS), no el slug de URL */
  tourSlug: keyof typeof TOUR_SLUGS;
  titulo: string;
  texto: string;
}
const { lang, tourSlug, titulo, texto } = Astro.props;
const t = useTranslations(lang);
const routes = useRoutes(lang);
const href = `${routes.tours}${TOUR_SLUGS[tourSlug][lang]}/`;
---

<aside class="not-prose my-8 rounded-[var(--radius-card)] bg-sand p-6">
  <p class="font-display text-xl font-extrabold uppercase text-forest">{titulo}</p>
  <p class="mt-1 text-foreground">{texto}</p>
  <a href={href} class="btn btn-primary mt-4">
    {t("cta.learnMore")} →
  </a>
</aside>
