---
// Bloque "foto grande + información breve + CTA", usado para tirolesa y parque.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  dark?: boolean;
  reverse?: boolean;
  eyebrow: string;
  title: string;
  lead: string;
  image: ImageMetadata;
  alt: string;
  imagePos?: string;
  /** imagen secundaria superpuesta (rompe la simetría) */
  image2?: ImageMetadata;
  alt2?: string;
}
const { dark = false, reverse = false, eyebrow, title, lead, image, alt, imagePos, image2, alt2 } = Astro.props;
---

<section class:list={["px-4 py-16 sm:px-6 sm:py-24", dark ? "bg-forest text-white" : "bg-sand/60 text-dark"]}>
  <div class="mx-auto grid max-w-7xl items-center gap-10 lg:grid-cols-2 lg:gap-16">
    <div class:list={["reveal relative", reverse && "lg:order-2"]}>
      <div class="photo-organic zoom-hover aspect-[4/5] sm:aspect-[5/4] lg:aspect-[4/5]">
        <Image
          src={image}
          alt={alt}
          widths={[500, 800, 1100]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          loading="lazy"
          class="h-full w-full object-cover"
          style={imagePos ? `object-position:${imagePos}` : undefined}
        />
      </div>
      {
        image2 && (
          <div class="photo-organic-alt absolute -bottom-6 -right-2 hidden w-2/5 rotate-2 border-4 border-cream shadow-card sm:block">
            <Image src={image2} alt={alt2 ?? ""} widths={[300, 500]} sizes="20vw" loading="lazy" class="aspect-square h-full w-full object-cover" />
          </div>
        )
      }
    </div>

    <div class="reveal" style="--d:120ms">
      <p class="eyebrow" style={dark ? "color:var(--color-accent-glow)" : undefined}>{eyebrow}</p>
      <h2 class="display-lg mt-2">{title}</h2>
      <p class:list={["mt-4 max-w-xl text-lg", dark ? "text-white/85" : "text-muted-foreground"]}>{lead}</p>
      <slot />
    </div>
  </div>
</section>
