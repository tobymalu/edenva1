---
import { Image } from "astro:assets";
import tripadvisor from "@/assets/partners/tripadvisor.png";
import viator from "@/assets/partners/viator.png";
import marietas from "@/assets/partners/marietas.png";
import { SOCIAL } from "@/consts";
import { useTranslations, type Lang } from "@/i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="bg-surface py-10 text-center">
  <div class="mx-auto max-w-4xl px-4">
    <h3 class="mb-6 text-xl">{t("home.partnersTitle")}</h3>
    <div class="flex flex-col items-center justify-center gap-8 sm:flex-row">
      <a href={SOCIAL.tripadvisor} target="_blank" rel="noopener noreferrer" class="block h-24 w-24 overflow-hidden rounded-full">
        <Image src={tripadvisor} alt="TripAdvisor" width={96} height={96} class="h-full w-full object-cover" />
      </a>
      <a href={SOCIAL.marietas} target="_blank" rel="noopener noreferrer" class="block h-24 w-24 overflow-hidden rounded-2xl">
        <Image src={marietas} alt="Islas Marietas" width={96} height={96} class="h-full w-full object-cover" />
      </a>
      <a href={SOCIAL.viator} target="_blank" rel="noopener noreferrer" class="block h-24 w-24 overflow-hidden">
        <Image src={viator} alt="Viator" width={96} height={96} class="h-full w-full object-cover" />
      </a>
    </div>
  </div>
</section>
