---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import type { Lang } from "@/i18n/ui";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  canonicalPath: string;
  langSwitchHref: string;
  h1: string;
  breadcrumbLabel: string;
  /** true mientras el texto legal sea un borrador sin revisión de un abogado. */
  noindex?: boolean;
}
const { lang, title, description, canonicalPath, langSwitchHref, h1, breadcrumbLabel, noindex = false } = Astro.props;
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  langSwitchHref={langSwitchHref}
  noindex={noindex}
  hideStickyBook
>
  <Breadcrumbs lang={lang} trail={[{ label: breadcrumbLabel, href: canonicalPath }]} />
  <article class="prose prose-edenva prose-h1:uppercase prose-h1:font-extrabold prose-h1:text-forest mx-auto max-w-3xl px-4 pb-16 pt-4">
    <h1>{h1}</h1>
    <slot />
  </article>
</BaseLayout>
