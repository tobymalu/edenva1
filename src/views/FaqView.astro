---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import featureRio from "@/assets/site/feature-rio.jpg";
import { FAQ } from "@/data/faq";
import { useTranslations, useRoutes, type Lang } from "@/i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const routes = useRoutes(lang);
const categories = FAQ[lang];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: categories.flatMap((cat) =>
    cat.items.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    }))
  ),
};
---

<BaseLayout
  lang={lang}
  title={lang === "es" ? "FAQ - Edenva" : "FAQ - Edenva"}
  description={t("faq.pageIntro")}
  canonicalPath={routes.faq}
  alternates={{ es: "/faq/", en: "/en/faq/" }}
  langSwitchHref={lang === "es" ? "/en/faq/" : "/faq/"}
  activeKey="faq"
>
  <Breadcrumbs lang={lang} trail={[{ label: t("nav.faq"), href: routes.faq }]} />

  <PageHero
    image={featureRio}
    eyebrow={lang === "es" ? "Antes de venir" : "Before you come"}
    title={t("faq.pageTitle")}
    lead={t("faq.pageIntro")}
  />

  <div class="mx-auto max-w-3xl px-4 py-14 sm:py-20">
    <div class="space-y-10">
      {
        categories.map((cat) => (
          <div>
            <h2 class="text-xl font-extrabold uppercase text-jungle">{cat.title}</h2>
            <div class="mt-3 divide-y divide-border overflow-hidden rounded-[var(--radius-card)] bg-surface shadow-card">
              {cat.items.map((item) => (
                <details class="group p-5">
                  <summary class="cursor-pointer list-none font-semibold text-foreground marker:content-none">
                    <span class="mr-2 inline-block font-extrabold text-accent transition group-open:rotate-45">+</span>
                    {item.question}
                  </summary>
                  <p class="mt-2 text-muted-foreground">{item.answer}</p>
                </details>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
</BaseLayout>
