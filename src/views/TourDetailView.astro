---
import { render, type CollectionEntry } from "astro:content";
import { getImage } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PageHero from "@/components/PageHero.astro";
import Carousel from "@/components/Carousel.astro";
import PriceTable from "@/components/PriceTable.astro";
import TrustBadge from "@/components/TrustBadge.astro";
import BookingCTA from "@/components/BookingCTA.astro";
import { CONTACT, GOOGLE_MAPS_EMBED } from "@/consts";
import { TOUR_SLUGS } from "@/data/slugMaps";
import { useTranslations, useRoutes, type Lang } from "@/i18n/utils";

interface Props {
  lang: Lang;
  entry: CollectionEntry<"tours">;
  folder: keyof typeof TOUR_SLUGS;
}
const { lang, entry, folder } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const t = useTranslations(lang);
const routes = useRoutes(lang);

const urlSlug = TOUR_SLUGS[folder][lang];
const canonicalPath = `${routes.tours}${urlSlug}/`;
const altLang: Lang = lang === "es" ? "en" : "es";
const altRoutes = useRoutes(altLang);
const alternateHref = `${altRoutes.tours}${TOUR_SLUGS[folder][altLang]}/`;

const ogImageSrc = data.seo.og_image ?? (await getImage({ src: data.cover, width: 1200, height: 630 })).src;
---

<BaseLayout
  lang={lang}
  title={data.seo.meta_title}
  description={data.seo.meta_description}
  canonicalPath={canonicalPath}
  ogImage={typeof ogImageSrc === "string" ? ogImageSrc : ogImageSrc.src}
  noindex={data.seo.noindex}
  alternates={{ [lang]: canonicalPath, [altLang]: alternateHref } as Record<Lang, string>}
  langSwitchHref={alternateHref}
  activeKey="tours"
  stickyItemId={data.fareharborItemId}
  stickyFlow={data.fareharborFlow}
>
  <Breadcrumbs
    lang={lang}
    trail={[
      { label: t("nav.tours"), href: routes.tours },
      { label: data.nombre, href: canonicalPath },
    ]}
  />

  <PageHero image={data.cover} alt={data.nombre} eyebrow={data.tipoTour} title={data.h1} lead={data.descripcion} />

  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:px-6 lg:grid-cols-[1fr_380px] lg:gap-14 lg:py-16">
    <article class="min-w-0">
      <Carousel id={`tour-${folder}`} images={data.galeria} alts={data.galeria.map(() => data.nombre)} />

      <div class="prose prose-edenva mt-10 max-w-none text-lg">
        <Content />
      </div>

      <div class="mt-10 grid gap-5 sm:grid-cols-2">
        <div class="rounded-[var(--radius-card)] bg-jungle p-6 text-white">
          <h2 class="text-xl font-extrabold uppercase">{t("tour.includes")}</h2>
          <ul class="mt-3 space-y-2 font-semibold">
            {data.incluye.map((item) => <li class="flex gap-2"><span aria-hidden="true" class="text-accent-glow">✓</span>{item}</li>)}
          </ul>
        </div>
        <div class="rounded-[var(--radius-card)] bg-sand p-6">
          <h2 class="text-xl font-extrabold uppercase text-forest">{t("tour.notIncluded")}</h2>
          <ul class="mt-3 space-y-2 font-semibold">
            {data.noIncluye.map((item) => <li class="flex gap-2"><span aria-hidden="true" class="text-earth">–</span>{item}</li>)}
          </ul>
        </div>
      </div>

      <div class="mt-6 rounded-[var(--radius-card)] border-2 border-accent/40 bg-surface p-6">
        <h2 class="text-xl font-extrabold uppercase text-forest">{t("tour.important")}</h2>
        <p class="mt-2 text-muted-foreground">{data.importante}</p>
      </div>
    </article>

    <aside class="lg:sticky lg:top-20 lg:self-start">
      <div class="rounded-[var(--radius-card)] bg-surface p-6 shadow-card">
        <PriceTable lang={lang} precios={data.precios} duracionHoras={data.duracionHoras} tipoTour={data.tipoTour} />

        <div class="mt-5 rounded-2xl bg-sand/60 p-4 text-sm">
          <p class="eyebrow !text-earth">{t("tour.schedule")}</p>
          <p class="mt-1"><strong>{t("tour.departure")}:</strong> {data.horario.salida}</p>
          <p><strong>{t("tour.return")}:</strong> {data.horario.regreso}</p>
          <p><strong>{t("tour.days")}:</strong> {data.horario.dias}</p>
        </div>

        <BookingCTA label={t("cta.bookAdventure")} itemId={data.fareharborItemId} flow={data.fareharborFlow} class="mt-5 w-full" />
        <div class="mt-3">
          <TrustBadge lang={lang} />
        </div>

        <div class="mt-5 grid grid-cols-2 gap-3 border-t border-border pt-5">
          <a href={CONTACT.phoneHref} class="btn btn-outline !min-h-11 !px-3 !text-xs">📞 {t("cta.call")}</a>
          <a href={CONTACT.whatsappHref} target="_blank" rel="noopener noreferrer" class="btn btn-outline !min-h-11 !px-3 !text-xs">💬 {t("cta.whatsapp")}</a>
        </div>
      </div>
    </aside>
  </div>

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6">
    <div class="photo-organic overflow-hidden shadow-card">
      <iframe
        src={GOOGLE_MAPS_EMBED}
        width="100%"
        height="400"
        style="border:0"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Edenva - Google Maps"
      ></iframe>
    </div>
  </section>
</BaseLayout>
