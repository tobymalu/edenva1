# Copia este archivo a .env para desarrollo local.
# En Cloudflare Pages, configura estas mismas variables en:
# Dashboard del proyecto > Settings > Environment variables
# (un build limpio en el hosting NO ve tu .env local).
#
# Todas empiezan con PUBLIC_ porque Astro solo expone al navegador
# las variables con ese prefijo. El código también trae un fallback
# hardcodeado con el valor de producción actual, por si esta variable
# no se configura en el hosting.

# Google Tag Manager — ID del contenedor (Admin > Instalar Google Tag Manager)
PUBLIC_GTM_ID=GTM-NFV2J262

# Meta (Facebook) Pixel ID — Events Manager > Configuración del pixel
PUBLIC_META_PIXEL_ID=1142171177145021
